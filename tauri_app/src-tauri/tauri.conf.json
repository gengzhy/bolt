{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bolt",
  "version": "0.1.0",
  "identifier": "xin.cosmos.bolt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bolt",
        "width": 780,
        "height": 540,
        "minWidth": 380,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "局域网点对点文件传输",
    "longDescription": "Bolt：纯局域网、无服务器的 P2P 文件传输工具",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}