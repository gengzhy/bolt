{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalTransfer",
  "version": "0.1.0",
  "identifier": "com.lt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalTransfer",
        "width": 780,
        "height": 540,
        "minWidth": 680,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "局域网点对点文件传输",
    "longDescription": "LocalTransfer：纯局域网、无服务器的 P2P 文件传输工具"
  }
}
